{%- comment -%}
  Renders a product tile.
  Params:
    product      — a Shopify product object (optional)
    ph_category  — placeholder category text (when no product)
    ph_name      — placeholder name
    ph_price     — placeholder price string
    ph_tag       — placeholder tag
    ph_label     — linen-ground caption
{%- endcomment -%}
{%- if product and product != blank -%}
  <a href="{{ product.url }}" class="pcard">
    <div class="pcard__media">
      {%- if product.featured_image -%}
        <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" loading="lazy">
        {%- if product.images[1] -%}
          <img class="pcard__img--alt" src="{{ product.images[1] | image_url: width: 800 }}" alt="" width="{{ product.images[1].width }}" height="{{ product.images[1].height }}" loading="lazy" aria-hidden="true">
        {%- endif -%}
      {%- else -%}
        <div class="pcard__linen"><span>{{ ph_label | default: 'foto de produto' }}</span></div>
      {%- endif -%}
      {%- if product.metafields.custom.tag != blank -%}
        <span class="tag tag--fill pcard__tag">{{ product.metafields.custom.tag }}</span>
      {%- elsif product.available == false -%}
        <span class="tag pcard__tag">Esgotado</span>
      {%- endif -%}
    </div>
    {%- assign cat = product.type | default: product.metafields.custom.category -%}
    {%- if cat != blank -%}<p class="pcard__cat">{{ cat }}</p>{%- endif -%}
    <div class="pcard__name">{{ product.title }}</div>
    <div class="pcard__price">{{ product.price | money_without_trailing_zeros }}</div>
    {%- comment -%}
      Swatches em cascata: hex do swatch → imagem do swatch → nada.
      O Shopify só entrega `swatch` quando a opção está tipada como Color no admin;
      em opção não tipada, `value.swatch` fica vazio e a fileira não sai — sem
      buraco no layout. Nunca um mapa de nomes-para-hex, que apodrece a cada cor
      nova do catálogo.
    {%- endcomment -%}
    {%- assign swatch_option = blank -%}
    {%- for option in product.options_with_values -%}
      {%- if swatch_option == blank and option.values.first.swatch != blank -%}
        {%- assign swatch_option = option -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if swatch_option != blank -%}
      <div class="pcard__swatches">
        {%- for value in swatch_option.values limit: 6 -%}
          {%- if value.swatch.color != blank -%}
            <span class="pcard__swatch" style="background:{{ value.swatch.color }};" title="{{ value | escape }}"></span>
          {%- elsif value.swatch.image != blank -%}
            <span class="pcard__swatch" style="background-image:url({{ value.swatch.image | image_url: width: 48 }});" title="{{ value | escape }}"></span>
          {%- endif -%}
        {%- endfor -%}
        {%- if swatch_option.values.size > 6 -%}
          <span class="pcard__swatch-more">+{{ swatch_option.values.size | minus: 6 }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </a>
{%- else -%}
  <a href="{{ ph_url | default: '#' }}" class="pcard">
    <div class="pcard__media">
      <div class="pcard__linen"><span>{{ ph_label | default: 'foto de produto' }}</span></div>
      {%- if ph_tag != blank -%}<span class="tag tag--fill pcard__tag">{{ ph_tag }}</span>{%- endif -%}
    </div>
    {%- if ph_category != blank -%}<p class="pcard__cat">{{ ph_category }}</p>{%- endif -%}
    <div class="pcard__name">{{ ph_name }}</div>
    <div class="pcard__price">{{ ph_price }}</div>
  </a>
{%- endif -%}
