<section class="gallery" data-screen-label="Galeria" data-gallery>
  <div class="gallery__track" data-gallery-track>
    {%- for block in section.blocks -%}
      <article class="gallery__frame" {{ block.shopify_attributes }}>
        <div class="gallery__media">
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.image.alt | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
          {%- elsif block.settings.asset != blank -%}
            <img src="{{ block.settings.asset | asset_url }}" alt="" width="928" height="1152" loading="lazy">
          {%- else -%}
            <div class="ph"><span>{{ block.settings.placeholder_label }}</span></div>
          {%- endif -%}
        </div>

        {%- if forloop.first and section.settings.heading != blank -%}
          <div class="gallery__overlay">
            <div class="gallery__caption">
              {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--inverse">{{ section.settings.eyebrow }}</p>{%- endif -%}
              <h2 class="gallery__title">{{ section.settings.heading }}</h2>
              {%- if section.settings.button_label != blank -%}
                <div class="mt-5"><a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--inverse">{{ section.settings.button_label }}</a></div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </article>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <button type="button" class="gallery__arrow gallery__arrow--prev" data-gallery-prev aria-label="{{ 'general.a11y.previous_photo' | t }}">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 4 7 12l8 8" fill="none" stroke="currentColor" stroke-width="1.25"/></svg>
    </button>
    <button type="button" class="gallery__arrow gallery__arrow--next" data-gallery-next aria-label="{{ 'general.a11y.next_photo' | t }}">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 4l8 8-8 8" fill="none" stroke="currentColor" stroke-width="1.25"/></svg>
    </button>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Galeria",
  "settings": [
    { "type": "paragraph", "content": "Faixa full-bleed de fotos verticais lado a lado, rolável na horizontal. O bloco de sobrelinha/título/botão aparece sobre a primeira foto. Regra #1: a bolsa fora da quadra." },
    { "type": "text", "id": "eyebrow", "label": "Sobrelinha", "default": "CHARTER — SS2026 01" },
    { "type": "text", "id": "heading", "label": "Título", "default": "A coleção do primeiro drop." },
    { "type": "text", "id": "button_label", "label": "Botão", "default": "Ver a coleção" },
    { "type": "url", "id": "button_link", "label": "Link do botão" }
  ],
  "blocks": [
    {
      "type": "frame",
      "name": "Foto",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "text", "id": "asset", "label": "Arquivo embutido (assets)", "info": "Usado quando não há foto escolhida acima.", "default": "photo-editorial-wall.jpg" },
        { "type": "text", "id": "placeholder_label", "label": "Legenda do placeholder", "default": "foto · a bolsa fora da quadra" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [{
    "name": "Galeria",
    "blocks": [
      { "type": "frame", "settings": { "asset": "photo-editorial-wall.jpg" } },
      { "type": "frame", "settings": { "asset": "photo-lemons-towel.png" } },
      { "type": "frame", "settings": { "asset": "photo-oranges-pool.png" } },
      { "type": "frame", "settings": { "asset": "photo-interlude-chair.jpg" } }
    ]
  }]
}
{% endschema %}
